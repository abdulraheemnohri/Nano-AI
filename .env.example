NANO_HOST=127.0.0.1
NANO_PORT=8000
NANO_DATA_DIR=
NANO_MODEL_DIR=
NANO_SKILLS_DIR=
NANO_DB=
NANO_LITERT_URL=http://127.0.0.1:9379
NANO_LITERT_MODEL=qwen3-1.7b
NANO_MODEL_NAME=Qwen3-1.7B_dynamic_wi4b32_afp32.litertlm
NANO_MAX_CONTEXT=4096
NANO_TEMPERATURE=0.7
NANO_LITERT_TIMEOUT=180
NANO_MAX_MESSAGE_CHARS=12000
NANO_LEARNING_ENABLED=true
NANO_STT_MODEL=
NANO_PIPER_COMMAND=piper
NANO_PIPER_VOICE=

# Set a strong random token before exposing the API beyond localhost.
NANO_API_TOKEN=
# Optional Playwright browser hostname allowlist (comma-separated, localhost is always allowed).
NANO_BROWSER_ALLOWED_HOSTS=
# Telegram integration credentials; configure a webhook with this secret when using inbound updates.
NANO_TELEGRAM_BOT_TOKEN=
NANO_TELEGRAM_WEBHOOK_SECRET=
# Additional approved HTTPS webhook hostnames, comma-separated.
NANO_WEBHOOK_ALLOWED_HOSTS=
# Optional workspace root for the restricted terminal runner.
NANO_WORKSPACE=
